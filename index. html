<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Terra Mágica - Simulador Medieval</title>
    <!-- Motor Phaser 3 -->
    <script src="https://cdn.jsdelivr.net/npm/phaser@3.60.0/dist/phaser.min.js"></script>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #1a1a1a;
            overflow: hidden;
            font-family: sans-serif;
        }
        #game-container {
            width: 100vw;
            height: 100vh;
        }
        .ui-overlay {
            position: absolute;
            top: 15px;
            left: 15px;
            color: white;
            background: rgba(0, 0, 0, 0.7);
            padding: 12px 18px;
            border-radius: 8px;
            font-size: 16px;
            pointer-events: none;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
    </style>
</head>
<body>

    <div class="ui-overlay">
        🏰 <strong>Terra Mágica</strong><br>
        🪵 Madera: <span id="wood-count">100</span> | 🪙 Oro: <span id="gold-count">50</span>
    </div>

    <div id="game-container"></div>

    <script>
        const config = {
            type: Phaser.AUTO,
            width: window.innerWidth,
            height: window.innerHeight,
            parent: 'game-container',
            pixelArt: true,
            scene: {
                preload: preload,
                create: create,
                update: update
            }
        };

        let wood = 100;
        let gold = 50;

        const game = new Phaser.Game(config);

        function preload() {
            // Cargamos imágenes de prueba para el castillo y la zona de recursos
            this.load.image('castillo', 'https://cdn.jsdelivr.net/gh/photonstorm/phaser3-examples@master/public/assets/sprites/castle.png');
            this.load.image('arbol', 'https://cdn.jsdelivr.net/gh/photonstorm/phaser3-examples@master/public/assets/sprites/tree.png');
        }

        function create() {
            // Fondo verde pasto
            this.cameras.main.setBackgroundColor('#347928');

            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;

            // Añadimos el Castillo en el centro
            const castillo = this.add.image(centerX, centerY, 'castillo');
            castillo.setScale(1.3);

            // Añadimos árboles decorativos alrededor simulando el bosque del leñador
            this.add.image(centerX - 120, centerY - 80, 'arbol').setScale(1.2);
            this.add.image(centerX + 140, centerY + 90, 'arbol').setScale(1.2);

            // Título de la aldea
            this.add.text(centerX, centerY + 130, "Aldea Principal", {
                font: "16px Arial",
                fill: "#ffffff",
                backgroundColor: "rgba(0,0,0,0.6)",
                padding: { x: 8, y: 4 }
            }).setOrigin(0.5);

            // Simulación de producción automática de madera cada 2 segundos
            this.time.addEvent({
                delay: 2000,
                callback: () => {
                    wood += 5;
                    document.getElementById('wood-count').innerText = wood;
                },
                loop: true
            });
        }

        function update() {
            // Lógica por fotograma
        }
    </script>
</body>
</html>

            
